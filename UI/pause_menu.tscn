[sub_resource type="GDScript" id="GDScript_et5lo"]
resource_name = "pause_menu"
script/source = "extends ColorRect

func _ready() -> void:
	PauseManager.on_pause_state_changed.connect(func(state: bool):
		if !state:
			queue_free()
		)

func _on_continue_buttom_pressed() -> void:
	PauseManager.set_pause_state(false)


func _on_options_buttom_pressed() -> void:
	PauseManager.spawn_options_menu()

func _on_exit_buttom_pressed() -> void:
	PauseManager.set_pause_state(false)
	get_tree().change_scene_to_file(\"uid://frfhml2058ny\")
"

