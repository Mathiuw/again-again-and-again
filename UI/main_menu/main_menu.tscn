[sub_resource type="GDScript" id="GDScript_du31s"]
resource_name = "main_menu"
script/source = "extends Control

func _ready() -> void:
	PauseManager.can_pause_input = false
	AudioManager.set_music(preload(\"uid://74xuctaer14g\"))


func _on_play_button_pressed() -> void:
	get_tree().change_scene_to_file(\"uid://cglc5tcgjld28\")


func _on_option_buttom_pressed() -> void:
	PauseManager.spawn_options_menu()


func _on_exit_buttom_pressed() -> void:
	get_tree().quit()
"

