[sub_resource type="GDScript" id="GDScript_v5jny"]
resource_name = "start_menu"
script/source = "extends Label

func _input(_event: InputEvent) -> void:
		
	if Input.is_anything_pressed():
		$\"../VBoxContainer\".show()
		queue_free()
"

