[sub_resource type="GDScript" id="GDScript_7pxnb"]
resource_name = "debug_fps"
script/source = "extends Control

@onready var label: Label = $MarginContainer/Label

func _process(_delta: float) -> void:
	label.text = \"{fps_count} FPS\".format({\"fps_count\" : Engine.get_frames_per_second()})
"

